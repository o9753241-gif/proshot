[Unit]
Description=ProShot FastAPI backend (iOS)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/backend-ios
Environment="PATH=/root/backend-ios/.venv/bin"
ExecStart=/root/backend-ios/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8011 --workers 4
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
