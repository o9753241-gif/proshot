# --- App ---
APP_ENV=prod
APP_SECRET=change-me-to-random-64-char-string
CORS_ORIGINS=*

# --- База ---
# Своя, отдельная от Android-инстанса (/root/backend/proshot.db).
DATABASE_URL=sqlite:///./proshot_ios.db

# --- Публичный адрес ---
# По нему DashScope скачивает входное фото, и по нему же клиент забирает результат.
PUBLIC_BASE_URL=https://ios-proshot.myprojekts.online

# --- DashScope ---
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/api/v1
DASHSCOPE_MODEL=qwen-image-edit-plus

# --- Google Play ---
# iOS-инстансу не нужны: покупки здесь проверяются через Apple (этап 4).
# Оставлены пустыми, чтобы код с общей развилкой по provider не падал.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_PACKAGE_NAME=ai.proshot.app
ALLOW_UNVERIFIED_PURCHASES=false

# --- Apple / StoreKit 2 ---
APPLE_BUNDLE_ID=ai.proshot.app
# Числовой ID приложения ProShot в App Store Connect
APPLE_APP_APPLE_ID=6818748505
# Корневые сертификаты Apple (.cer) с https://www.apple.com/certificateauthority/
APPLE_ROOT_CA_DIR=/root/backend-ios/secrets/apple_roots
# Ключ App Store Server API: .p8 скачивается один раз
APPLE_KEY_ID=
APPLE_ISSUER_ID=
APPLE_PRIVATE_KEY_PATH=/root/backend-ios/secrets/AuthKey.p8
APPLE_ONLINE_CHECKS=false
# Согласие пользователя на передачу данных о потреблении (нужен экран в приложении)
APPLE_CONSUMPTION_CONSENTED=false
# Позиция по возврату для израсходованного пакета
APPLE_REFUND_PREFERENCE_WHEN_CONSUMED=PREFER_DECLINE

# --- App Attest и токен устройства (как в Starshot iOS) ---
# observe — только журнал [ATTEST]; enforce — без заверения нет токена,
# без токена нет покупок и генераций. Включать enforce только после того,
# как в журнале видно ok=True с телефона.
ATTEST_MODE=observe
APPLE_TEAM_ID=83FXJTKVDQ
APPLE_ATTEST_ROOT_CA=/root/backend-ios/secrets/Apple_App_Attestation_Root_CA.pem
# Ключ подписи токенов; deploy.sh генерирует его при первом развёртывании.
DEVICE_TOKEN_SECRET=
# 1 — пока не enforce, запросы без токена принимаются по X-Device-Id.
DEVICE_TOKEN_GRACE=1
