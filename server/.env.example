# --- App ---
APP_ENV=prod
APP_SECRET=change-me-to-random-64-char-string
CORS_ORIGINS=*

# --- База ---
# Своя, отдельная от Android-инстанса (/root/backend/proshot.db).
DATABASE_URL=sqlite:///./proshot_ios.db

# --- Публичный адрес ---
# По нему DashScope скачивает входное фото, и по нему же клиент забирает результат.
PUBLIC_BASE_URL=https://proshot-ios.89-221-203-218.sslip.io

# --- DashScope ---
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/api/v1
DASHSCOPE_MODEL=qwen-image-edit-plus

# --- Google Play ---
# iOS-инстансу не нужны: покупки здесь проверяются через Apple (этап 4).
# Оставлены пустыми, чтобы код с общей развилкой по provider не падал.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_PACKAGE_NAME=ai.proshot.app
ALLOW_UNVERIFIED_PURCHASES=false
